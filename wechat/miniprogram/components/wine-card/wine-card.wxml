<view class="wine-card {{catalogMode ? 'wine-card-catalog' : wine.rank === 1 ? 'wine-card-main' : ''}}">
  <view class="wine-card-head">
    <view class="wine-card-copy">
      <text wx:if="{{!catalogMode}}" class="wine-rank">{{wine.rank === 1 ? '优先推荐' : wine.rankLabel}}</text>
      <text class="wine-name">{{wine.name}}</text>
      <text class="wine-brand">{{wine.specText}}</text>
    </view>
  </view>

  <view class="wine-tags">
    <text class="wine-tag">{{wine.aroma}}型 · {{wine.abv}}度</text>
    <view class="wine-price"><text class="wine-price-label">参考价 </text><text class="wine-price-value">¥{{wine.price}}</text><text class="wine-price-label"> / 瓶</text></view>
  </view>
  <text wx:if="{{!catalogMode}}" class="wine-why">{{wine.whyText}}</text>
  <text wx:if="{{!catalogMode}}" class="wine-block-text">权衡：{{wine.tradeoffText}}</text>
  <text class="wine-block-text">选购提醒：{{wine.caution}}</text>
  <text class="wine-quality-notice">{{wine.qualityNotice}}</text>

  <view wx:if="{{expanded}}" class="wine-details">
    <view class="wine-block">
      <text class="wine-block-title">酒款特点</text>
      <text class="wine-block-text">{{wine.highlight}}</text>
      <text class="wine-block-text">口感：{{wine.tasteText}}</text>
      <text class="wine-block-text">{{wine.brand}} · {{wine.region}} · {{wine.priceTier}}</text>
    </view>
    <view class="wine-block wine-block-caution">
      <text class="wine-block-title">资料依据</text>
      <text class="wine-block-text" selectable>{{wine.priceNote}}</text>
      <text class="wine-block-text" selectable>{{wine.sourceText}}</text>
    </view>
  </view>
  <view class="wine-actions">
    <button class="wine-buy" bindtap="copyPurchaseKeyword">复制搜索词</button>
    <button class="wine-buy wine-detail-toggle" bindtap="toggleDetails">{{expanded ? '收起详情' : '口感与资料'}}</button>
  </view>
</view>
