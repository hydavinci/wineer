.wine-card {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 32rpx;
  border: 1rpx solid #ddded6;
  border-radius: 20rpx;
  background: #ffffff;
  color: #242722;
}

.wine-card-main {
  border-top: 4rpx solid #80603a;
}

.wine-card-catalog {
  gap: 14rpx;
  padding: 28rpx 0;
  border: 0;
  border-radius: 0;
  border-bottom: 1rpx solid #ddded6;
}

.wine-card-copy {
  min-width: 0;
}

.wine-rank {
  display: block;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #80603a;
}

.wine-name {
  display: block;
  margin-bottom: 8rpx;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.wine-card-catalog .wine-name {
  font-size: 30rpx;
}

.wine-brand,
.wine-tag,
.wine-price-label {
  color: #696c65;
  font-size: 24rpx;
  line-height: 1.6;
}

.wine-brand {
  display: block;
}

.wine-tags {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 8rpx 20rpx;
}

.wine-price-value {
  color: #242722;
  font-size: 36rpx;
  font-weight: 600;
}

.wine-why,
.wine-block-text {
  display: block;
  font-size: 26rpx;
  line-height: 1.8;
  overflow-wrap: anywhere;
}

.wine-block-text {
  color: #696c65;
}

.wine-details,
.wine-block {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.wine-details {
  padding-top: 20rpx;
  border-top: 1rpx solid #ddded6;
  gap: 24rpx;
}

.wine-block-title {
  color: #242722;
  font-size: 26rpx;
  font-weight: 600;
}

.wine-quality-notice {
  display: block;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: #f6f2e9;
  color: #655139;
  font-size: 24rpx;
  line-height: 1.8;
}

.wine-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.wine-buy {
  flex: 1;
  min-width: 200rpx;
  min-height: 44px;
  box-sizing: border-box;
  margin: 0;
  padding: 16rpx 20rpx;
  border: 1rpx solid #ddded6;
  border-radius: 12rpx;
  background: #ffffff;
  color: #80603a;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.6;
}

.wine-buy::after {
  border: none;
}

.wine-detail-toggle {
  color: #696c65;
  border-color: transparent;
}
