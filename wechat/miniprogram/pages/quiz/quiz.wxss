.quiz-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.quiz-title {
  display: block;
  margin-bottom: 14rpx;
  font-size: 42rpx;
  font-weight: 700;
  color: #242722;
}

.quiz-description {
  display: block;
  font-size: 28rpx;
  line-height: 1.7;
}

.quiz-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.slider-card {
  padding-top: 28rpx;
  padding-bottom: 28rpx;
}

.slider-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.slider-copy {
  flex: 1;
}

.slider-title {
  display: block;
  margin-bottom: 10rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.5;
  color: #242722;
}

.slider-hint {
  display: block;
  font-size: 26rpx;
  line-height: 1.7;
}

.slider-value {
  min-width: 72rpx;
  padding: 10rpx 0;
  border-radius: 12rpx;
  background: #f3ede2;
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
  color: #80603a;
}

.slider-labels {
  display: flex;
  justify-content: space-between;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.quiz-submit {
  margin-top: 8rpx;
}

.advanced-toggle {
  gap: 16rpx;
  color: #80603a;
}

.advanced-chevron {
  flex-shrink: 0;
  width: 12rpx;
  height: 12rpx;
  margin-top: -6rpx;
  border-right: 2rpx solid currentColor;
  border-bottom: 2rpx solid currentColor;
  transform: rotate(45deg);
}

.advanced-chevron.is-open {
  margin-top: 6rpx;
  transform: rotate(225deg);
}

.option-card {
  padding: 32rpx;
}

.option-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin: 20rpx 0;
}

.option-item {
  display: flex;
  align-items: center;
  min-width: 0;
  min-height: 44px;
  box-sizing: border-box;
  padding: 16rpx 12rpx;
  border: 1rpx solid #ddded6;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.occasion-options .option-item:last-child {
  grid-column: 1 / -1;
}

.option-selected,
.option-focused {
  border-color: #80603a;
  background: #f3ede2;
}

.quiz-focus-hint {
  display: block;
  margin-top: 20rpx;
  color: #80603a;
  font-size: 26rpx;
}
