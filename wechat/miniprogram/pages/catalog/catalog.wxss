.catalog-title {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
}

.catalog-filters {
  padding: 0;
}

.catalog-description {
  display: block;
  margin: 16rpx 0 24rpx;
  font-size: 26rpx;
  line-height: 1.7;
}

.catalog-search {
  height: 88rpx;
  padding: 0 24rpx;
  min-height: 44px;
  border: 1rpx solid #ddded6;
  border-radius: 12rpx;
  background: #ffffff;
  color: #242722;
  font-size: 28rpx;
}

.catalog-selects {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.catalog-picker {
  flex: 1;
  min-width: 240rpx;
}

.catalog-select {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-height: 44px;
  padding: 16rpx 20rpx;
  border: 1rpx solid #ddded6;
  border-radius: 12rpx;
  background: #ffffff;
  font-size: 26rpx;
}

.catalog-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
  margin-top: 12rpx;
  font-size: 24rpx;
}

.catalog-reset {
  margin: 0;
  padding: 0 16rpx;
  background: transparent;
  color: #80603a;
  font-size: 26rpx;
}

.catalog-reset::after {
  border: none;
}

.catalog-list {
  margin-bottom: 24rpx;
  padding: 0 24rpx;
  border: 1rpx solid #ddded6;
  border-radius: 20rpx;
  background: #ffffff;
}

.catalog-state {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 24rpx;
}

.catalog-end {
  display: block;
  padding: 24rpx 0;
  text-align: center;
  font-size: 24rpx;
}
