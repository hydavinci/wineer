.home-page {
  display: flex;
  align-items: center;
  justify-content: center;
}

.home-card {
  width: 100%;
  text-align: center;
}

.home-logo-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.home-logo-mark {
  font-size: 64rpx;
  margin-right: 16rpx;
}

.home-logo-text {
  color: #e0be6a;
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.home-title {
  display: block;
  margin-bottom: 16rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #f2e9df;
}

.home-description {
  display: block;
  margin-bottom: 40rpx;
  font-size: 30rpx;
  line-height: 1.7;
}

.home-warning {
  display: flex;
  flex-direction: column;
  padding: 24rpx 28rpx;
  border: 1rpx solid #3a2b25;
  border-radius: 24rpx;
  background: rgba(201, 162, 75, 0.08);
  font-size: 24rpx;
  line-height: 1.7;
}

.home-warning .muted + .muted {
  margin-top: 12rpx;
}

.home-start {
  margin-top: 40rpx;
}

.home-browse {
  margin-top: 20rpx;
}
