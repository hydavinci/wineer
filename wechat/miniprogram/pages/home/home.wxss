.home-page {
  display: flex;
  align-items: center;
  justify-content: center;
}

.home-content {
  width: 100%;
  max-width: 680rpx;
  padding: 48rpx 0;
}

.home-logo-wrap {
  margin-bottom: 48rpx;
}

.home-logo-text {
  color: #80603a;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
}

.home-title {
  display: block;
  margin-bottom: 20rpx;
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.35;
}

.home-description {
  display: block;
  font-size: 30rpx;
  line-height: 1.8;
}

.home-warning {
  display: flex;
  flex-direction: column;
  margin-top: 56rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid #ddded6;
  font-size: 26rpx;
  line-height: 1.8;
}

.home-start {
  margin-top: 32rpx;
}

.home-browse {
  display: flex;
  width: 100%;
  margin-top: 12rpx;
}
