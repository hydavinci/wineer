.result-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.result-state-card {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  text-align: center;
}

.result-state-title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #242722;
}

.result-state-copy {
  display: block;
  font-size: 28rpx;
  line-height: 1.8;
}

.result-state-action {
  margin-top: 12rpx;
}

.result-head {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.result-eyebrow {
  color: #80603a;
  font-size: 26rpx;
}

.result-title {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  color: #242722;
}

.result-description {
  display: block;
  font-size: 26rpx;
  line-height: 1.8;
}

.result-actions,
.result-navigation {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8rpx 16rpx;
}

.result-navigation {
  padding-top: 12rpx;
  border-top: 1rpx solid #ddded6;
}

.result-buy-hint {
  display: block;
  font-size: 26rpx;
  line-height: 1.7;
}

.result-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.reporting-settings {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 28rpx;
  font-size: 26rpx;
  line-height: 1.7;
}

.reporting-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.poster-canvas {
  position: fixed;
  left: -10000px;
  top: 0;
  width: 300px;
  height: 480px;
  opacity: 0;
  pointer-events: none;
}
