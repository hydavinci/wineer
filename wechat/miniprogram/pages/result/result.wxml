<view class="page result-page">
  <view wx:if="{{agePending}}" class="card result-state-card">
    <text class="result-state-title">请先确认已满 18 岁</text>
    <text class="muted">确认后将继续展示这次分享的推荐。</text>
    <button class="button-primary" bindtap="confirmAge">确认后继续</button>
  </view>
  <view wx:elif="{{isLoading}}" class="card result-state-card">
    <text class="result-state-title">正在生成推荐…</text>
    <text class="result-state-copy muted">会根据你的六维偏好和本地酒款库，计算最适合的 Top 3。</text>
  </view>

  <view wx:elif="{{errorMessage}}" class="card result-state-card">
    <text class="result-state-title">暂时没法给出推荐</text>
    <text class="result-state-copy muted">{{errorMessage}}</text>
    <button class="button-secondary result-state-action" disabled="{{navigationBusy}}" bindtap="adjustPreferences">调整偏好</button>
  </view>

  <block wx:else>
    <view class="result-head">
      <text class="result-eyebrow">你的推荐结果</text>
      <text class="result-title">{{wines.length ? '为你挑选的白酒' : '预算内暂无合适酒款'}}</text>
      <text class="result-description muted">{{budgetLabel}}；按静态参考价筛选，合适的低价款也会推荐。成交价可能超预算，购买前请核实规格和报价。</text>
      <text wx:if="{{wines.length < 3}}" class="muted">按预算筛选并去除已确认同款后，可展示 {{wines.length}} 款，不用超预算款凑数。</text>
    </view>

    <view class="result-list">
      <wine-card
        wx:for="{{wines}}"
        wx:key="id"
        wine="{{item}}"
        bind:buy="copyPurchaseKeyword"
      />
    </view>
    <text wx:if="{{wines.length}}" class="result-buy-hint muted">同分时先看偏好冲突和报价依据；条件相同时，备选尽量提供不同品牌，再按参考价与固定 ID 排序。排名不是满意概率，报价也不是成交保证。</text>
    <button class="button-primary" loading="{{navigationBusy}}" disabled="{{navigationBusy}}" bindtap="adjustPreferences">调整偏好 · 保留当前选择</button>

    <view wx:if="{{wines.length && reportingAvailable}}" class="card reporting-settings">
      <label class="reporting-option">
        <text>允许向开发者发送使用记录</text>
        <switch checked="{{reportingEnabled}}" bindchange="toggleReporting" color="#80603a" />
      </label>
      <button wx:if="{{reportingEnabled}}" class="button-secondary" loading="{{reportingBusy}}" disabled="{{reportingBusy}}" bindtap="uploadEvents">上报本机记录 / 重试</button>
      <text class="muted">{{reportStatus}}</text>
    </view>

    <view wx:if="{{wines.length}}" class="result-actions">
      <button class="button-link" open-type="share">转发给朋友</button>
      <button class="button-link" loading="{{posterBusy}}" disabled="{{posterBusy}}" bindtap="generatePoster">生成海报</button>
      <button wx:if="{{posterPath}}" class="button-link" loading="{{saveBusy}}" disabled="{{saveBusy}}" bindtap="savePoster">保存到相册</button>
    </view>
    <text wx:if="{{wines.length}}" class="muted result-buy-hint">建议转发小程序卡片，朋友可直接打开；海报没有扫码入口。价格与规格请核实，请理性饮酒。</text>
    <view class="result-navigation">
      <button class="button-link" disabled="{{navigationBusy}}" bindtap="openCatalog">浏览全部酒库</button>
      <button class="button-link" disabled="{{navigationBusy}}" bindtap="restart">全部重选</button>
    </view>
  </block>

  <canvas
    id="posterCanvas"
    type="2d"
    class="poster-canvas"
  />
</view>
