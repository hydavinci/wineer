page {
  background: #f7f6f2;
  color: #242722;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  background: #f7f6f2;
  color: #242722;
  font-size: 28rpx;
  line-height: 1.6;
}

.card {
  background: #ffffff;
  border: 1rpx solid #ddded6;
  border-radius: 20rpx;
  padding: 32rpx;
}

.button-primary,
.button-secondary {
  width: 100%;
  box-sizing: border-box;
  min-height: 44px;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.2;
  text-align: center;
}

.button-primary {
  color: #ffffff;
  background: #242722;
}

.button-secondary {
  color: #242722;
  background: #ffffff;
  border: 1rpx solid #ddded6;
}

.button-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 44px;
  margin: 0;
  padding: 12rpx 16rpx;
  background: transparent;
  color: #696c65;
  font-size: 28rpx;
  line-height: 1.5;
}

/* Explicit native states keep the light theme consistent during navigation. */
.button-primary[disabled],
.button-primary[loading] {
  color: #ffffff !important;
  background: #242722 !important;
}

.button-secondary[disabled],
.button-secondary[loading] {
  color: #242722 !important;
  background: #ffffff !important;
}

.button-link[disabled],
.button-link[loading] {
  color: #696c65 !important;
  background: transparent !important;
}

.button-primary[disabled],
.button-secondary[disabled],
.button-link[disabled] {
  opacity: 0.65;
}

.button-primary::after,
.button-secondary::after,
.button-link::after {
  border: none;
}

.muted {
  color: #696c65;
}
