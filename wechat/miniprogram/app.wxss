.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: calc(48rpx + env(safe-area-inset-top)) 32rpx calc(48rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #2a1d18 0%, #1a1210 58%);
  color: #f2e9df;
}

.card {
  background: linear-gradient(180deg, #2e211d 0%, #241a17 100%);
  border: 1rpx solid #3a2b25;
  border-radius: 32rpx;
  padding: 56rpx 44rpx;
  box-shadow: 0 24rpx 80rpx rgba(0, 0, 0, 0.35);
}

.button-primary,
.button-secondary {
  width: 100%;
  border-radius: 28rpx;
  padding: 28rpx 32rpx;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.2;
  text-align: center;
}

.button-primary {
  color: #2a1d10;
  background: linear-gradient(135deg, #e0be6a 0%, #c9a24b 100%);
}

.button-secondary {
  color: #e0be6a;
  background: rgba(201, 162, 75, 0.1);
  border: 1rpx solid rgba(201, 162, 75, 0.28);
}

/* Native button state rules must not replace the theme with a white background. */
.button-primary[disabled],
.button-primary[loading] {
  color: #2a1d10 !important;
  background: linear-gradient(135deg, #e0be6a 0%, #c9a24b 100%) !important;
}

.button-secondary[disabled],
.button-secondary[loading] {
  color: #e0be6a !important;
  background: rgba(201, 162, 75, 0.1) !important;
}

.button-primary[disabled],
.button-secondary[disabled] {
  opacity: 0.65;
}

.button-primary::after,
.button-secondary::after {
  border: none;
}

.muted {
  color: #a99a8c;
}
